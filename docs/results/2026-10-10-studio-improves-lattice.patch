+
+
+def test_changes_list_is_newest_first(tmp_path: Path, serve) -> None:
+    gen = ScriptedGenerator([edit_reply(NOTES_V2), V2_DRAFT])
+    s = serve(make_project(tmp_path / "p"), gen)
+    assert s.get("/api/changes") == (200, [])
+    _, out = s.post("/api/changes", {"request": "first"})
+    s.wait_change(out["id"])
+    status, listed = s.get("/api/changes")
+    assert status == 200
+    assert listed == [{"id": out["id"], "status": "ready", "request": "first"}]
