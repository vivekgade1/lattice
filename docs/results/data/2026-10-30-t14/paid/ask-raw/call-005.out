,\"citations\":[{\"target\":\"invariant:one_device_per_push_token\",\"step\":null,\"quote\":\"A push_token is on at most one device row.\"},{\"target\":\"rule:R31\",\"step\":null,\"quote\":\"`POST /v1/devices` takes `{installation_id, platform, push_token, timezone, app_version}` and answers 201 with the device\"},{\"target\":\"rule:R32\",\"step\":null,\"quote\":\"there is never more than one row per `push_token`\"}],\"implementation\":\"not_specified_not_implemented\",\"implementation_basis\":\"inferred\"}","ttft_ms":3611,"type":"result","duration_ms":5376,"uuid":"fb65a2a8-3d3a-4757-a823-c60a7fd1700b","ttft_stream_ms":1672,"time_to_request_ms":20,"first_content_frame_ms":1672,"queued_turn_count":0,"result_index":0}
