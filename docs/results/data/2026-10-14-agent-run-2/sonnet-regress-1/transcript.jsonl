s. Writing one would let future checks point at exactly what's impacted."}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":999,"cache_read_input_tokens":68046,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":999},"output_tokens":656,"service_tier":"standard","inference_geo":"global"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"087a99a1-2736-4b62-8089-7fef552d1b72","uuid":"522294e9-062e-41fb-b602-dae1edb8b721","timestamp":"2026-10-14T16:51:41.497Z","request_id":"req_011Cg2UYBYrNnKALFDU2HqPC"}
