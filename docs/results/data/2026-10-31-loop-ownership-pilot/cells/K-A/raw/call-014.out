{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GjfqJr3Lba7PLqo9Wh7tKQ","type":"tool_result","content":"\"\"\"The spec of the toy shelf service (Spike I, Arm L): 7 scenarios of ``Rpc`` steps and one invariant.\"\"\"\n\nfrom __future__ import annotations\n\nfrom harness import PROTOS\nfrom visible_spec import VISIBLE_SCENARIOS\n\nfrom lattice.profile import ApiProfile, Profile\nfrom lattice.spec import Invariant, Rpc, Scenario, Spec\nfrom lattice.typesys import Scalar, Schema\n\nS = Scalar\nSHELF = \"toy.v1.Shelf\"\n\nITEM = Schema.from_pairs(\n    [(\"id\", S.INT), (\"name\", S.STR), (\"qty\", S.INT)],\n    keys=[(\"id\",), (\"name\",)],\n)\nPROFILE = Profile(\n    schemas={},\n    api=ApiProfile(\n        tables={\"Item\": ITEM},\n        table_names={\"Item\": \"items\"},\n        roles=frozenset({\"Public\"}),\n        error_body=\"fastapi\",\n    ),\n)\nNON_NEGATIVE = Invariant(\"qty_non_negative\", \"A stored quantity is never negative.\", \"Item.qty >= 0\")\n\n\ndef add(name: str, qty: int = 1, **kw) -> Rpc:\n    return Rpc(SHELF, \"AddItem\", None, {\"name\": name, \"qty\": qty}, **kw)\n\n\nSCENARIOS = (\n    Scenario(\n        \"add_and_get\",\n        steps=(\n            add(\n                \"widget\",\n                3,\n                expect_message={\"id\": 1, \"name\": \"widget\", \"qty\": 3},\n                expect_db={\"Item\": {\"count\": 1}},\n            ),\n            Rpc(SHELF, \"GetItem\", None, {\"id\": 1}, expect_message={\"id\": 1, \"name\": \"widget\", \"qty\": 3}),\n        ),\n    ),\n    Scenario(\n        \"add_empty_name\",\n        steps=(add(\"\", 1, expect_code=\"INVALID_ARGUMENT\", expect_db={\"Item\": {\"count\": 0}}),),\n    ),\n    Scenario(\n        \"add_negative_qty\",\n        steps=(add(\"bolt\", -1, expect_code=\"INVALID_ARGUMENT\", expect_db={\"Item\": {\"count\": 0}}),),\n    ),\n    Scenario(\n        \"add_duplicate_name\",\n        steps=(\n            add(\"nut\", 2, expect_db={\"Item\": {\"count\": 1}}),\n            add(\"nut\", 5, expect_code=\"ALREADY_EXISTS\", expect_db={\"Item\": {\"count\": 1}}),\n        ),\n    ),\n    Scenario(\n        \"get_missing\",\n        steps=(Rpc(SHELF, \"GetItem\", None, {\"id\": 99}, expect_code=\"NOT_FOUND\"),),\n    ),\n    Scenario(\n        \"list_oldest_first\",\n        steps=(\n            add(\"a\", 1),\n            add(\"b\", 2),\n            add(\"c\", 3),\n            Rpc(\n                SHELF,\n                \"ListItems\",\n                None,\n                {},\n                expect_message={\n                    \"items\": [\n                        {\"id\": 1, \"name\": \"a\", \"qty\": 1},\n16:                expect_code=\"INVALID_ARGUMENT\",","is_error":false}]},"parent_tool_use_id":null,"session_id":"56992662-8755-4de5-bbdd-29cbbb0f99a3","uuid":"4d89440f-b4bc-493a-8b8a-60ca922a7ce0","timestamp":"2026-10-31T21:31:33.776Z","tool_use_result":{"stdout":"\"\"\"The spec of the toy shelf service (Spike I, Arm L): 7 scenarios of ``Rpc`` steps and one invariant.\"\"\"\n\nfrom __future__ import annotations\n\nfrom harness import PROTOS\nfrom visible_spec import VISIBLE_SCENARIOS\n\nfrom lattice.profile import ApiProfile, Profile\nfrom lattice.spec import Invariant, Rpc, Scenario, Spec\nfrom lattice.typesys import Scalar, Schema\n\nS = Scalar\nSHELF = \"toy.v1.Shelf\"\n\nITEM = Schema.from_pairs(\n    [(\"id\", S.INT), (\"name\", S.STR), (\"qty\", S.INT)],\n    keys=[(\"id\",), (\"name\",)],\n)\nPROFILE = Profile(\n    schemas={},\n    api=ApiProfile(\n        tables={\"Item\": ITEM},\n        table_names={\"Item\": \"items\"},\n        roles=frozenset({\"Public\"}),\n        error_body=\"fastapi\",\n    ),\n)\nNON_NEGATIVE = Invariant(\"qty_non_negative\", \"A stored quantity is never negative.\", \"Item.qty >= 0\")\n\n\ndef add(name: str, qty: int = 1, **kw) -> Rpc:\n    return Rpc(SHELF, \"AddItem\", None, {\"name\": name, \"qty\": qty}, **kw)\n\n\nSCENARIOS = (\n    Scenario(\n        \"add_and_get\",\n        steps=(\n            add(\n                \"widget\",\n                3,\n                expect_message={\"id\": 1, \"name\": \"widget\", \"qty\": 3},\n                expect_db={\"Item\": {\"count\": 1}},\n            ),\n            Rpc(SHELF, \"GetItem\", None, {\"id\": 1}, expect_message={\"id\": 1, \"name\": \"widget\", \"qty\": 3}),\n        ),\n    ),\n    Scenario(\n        \"add_empty_name\",\n        steps=(add(\"\", 1, expect_code=\"INVALID_ARGUMENT\", expect_db={\"Item\": {\"count\": 0}}),),\n    ),\n    Scenario(\n        \"add_negative_qty\",\n        steps=(add(\"bolt\", -1, expect_code=\"INVALID_ARGUMENT\", expect_db={\"Item\": {\"count\": 0}}),),\n    ),\n    Scenario(\n        \"add_duplicate_name\",\n        steps=(\n            add(\"nut\", 2, expect_db={\"Item\": {\"count\": 1}}),\n            add(\"nut\", 5, expect_code=\"ALREADY_EXISTS\", expect_db={\"Item\": {\"count\": 1}}),\n        ),\n    ),\n    Scenario(\n        \"get_missing\",\n        steps=(Rpc(SHELF, \"GetItem\", None, {\"id\": 99}, expect_code=\"NOT_FOUND\"),),\n    ),\n    Scenario(\n        \"list_oldest_first\",\n        steps=(\n            add(\"a\", 1),\n            add(\"b\", 2),\n            add(\"c\", 3),\n            Rpc(\n                SHELF,\n                \"ListItems\",\n                None,\n                {},\n                expect_message={\n                    \"items\": [\n                        {\"id\": 1, \"name\": \"a\", \"qty\": 1},\n16:                expect_code=\"INVALID_ARGUMENT\",","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01GjfqJr3Lba7PLqo9Wh7tKQ","permission_decision":{"decision":"accept","source":"config","reason_type":"subcommandResults"}}]}
