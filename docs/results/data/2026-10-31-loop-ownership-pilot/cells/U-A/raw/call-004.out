{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HUdGKkCG4r5Zwk82284f32","type":"tool_result","content":"\"\"\"The spec of the toy shelf service (Spike I, Arm L): 7 scenarios of ``Rpc`` steps and one invariant.\"\"\"\n\nfrom __future__ import annotations\n\nfrom harness import PROTOS\n\nfrom lattice.profile import ApiProfile, Profile\nfrom lattice.spec import Invariant, Rpc, Scenario, Spec\nfrom lattice.typesys import Scalar, Schema\n\nS = Scalar\nSHELF = \"toy.v1.Shelf\"\n\nITEM = Schema.from_pairs(\n    [(\"id\", S.INT), (\"name\", S.STR), (\"qty\", S.INT)],\n    keys=[(\"id\",), (\"name\",)],\n)\nPROFILE = Profile(\n    schemas={},\n    api=ApiProfile(\n        tables={\"Item\": ITEM},\n        table_names={\"Item\": \"items\"},\n        roles=frozenset({\"Public\"}),\n        error_body=\"fastapi\",\n    ),\n)\nNON_NEGATIVE = Invariant(\"qty_non_negative\", \"A stored quantity is never negative.\", \"Item.qty >= 0\")\n\n\ndef add(name: str, qty: int = 1, **kw) -> Rpc:\n    return Rpc(SHELF, \"AddItem\", None, {\"name\": name, \"qty\": qty}, **kw)\n\n\nSCENARIOS = (\n    Scenario(\n        \"add_and_get\",\n        steps=(\n            add(\n                \"widget\",\n                3,\n                expect_message={\"id\": 1, \"name\": \"widget\", \"qty\": 3},\n                expect_db={\"Item\": {\"count\": 1}},\n            ),\n            Rpc(SHELF, \"GetItem\", None, {\"id\": 1}, expect_message={\"id\": 1, \"name\": \"widget\", \"qty\": 3}),\n        ),\n    ),\n    Scenario(\n        \"add_empty_name\",\n        steps=(add(\"\", 1, expect_code=\"INVALID_ARGUMENT\", expect_db={\"Item\": {\"count\": 0}}),),\n    ),\n    Scenario(\n        \"add_negative_qty\",\n        steps=(add(\"bolt\", -1, expect_code=\"INVALID_ARGUMENT\", expect_db={\"Item\": {\"count\": 0}}),),\n    ),\n    Scenario(\n        \"add_duplicate_name\",\n        steps=(\n            add(\"nut\", 2, expect_db={\"Item\": {\"count\": 1}}),\n            add(\"nut\", 5, expect_code=\"ALREADY_EXISTS\", expect_db={\"Item\": {\"count\": 1}}),\n        ),\n    ),\n    Scenario(\n        \"get_missing\",\n        steps=(Rpc(SHELF, \"GetItem\", None, {\"id\": 99}, expect_code=\"NOT_FOUND\"),),\n    ),\n    Scenario(\n        \"list_oldest_first\",\n        steps=(\n            add(\"a\", 1),\n            add(\"b\", 2),\n            add(\"c\", 3),\n            Rpc(\n                SHELF,\n                \"ListItems\",\n                None,\n                {},\n                expect_message={\n                    \"items\": [\n                        {\"id\": 1, \"name\": \"a\", \"qty\": 1},\n                        {\"id\": 2, \"name\": \"b\", \"qty\": 2},\n                        {\"id\": 3, \"name\": \"c\", \"qty\": 3},\n                    ]\n                },\n            ),\n        ),\n    ),\n    Scenario(\n        \"remove_then_again\",\n        steps=(\n            add(\"gear\", 4, expect_db={\"Item\": {\"count\": 1}}),\n            Rpc(SHELF, \"RemoveItem\", None, {\"id\": 1}, expect_db={\"Item\": {\"count\": 0}}),\n            Rpc(SHELF, \"RemoveItem\", None, {\"id\": 1}, expect_code=\"NOT_FOUND\"),\n            Rpc(SHELF, \"GetItem\", None, {\"id\": 1}, expect_code=\"NOT_FOUND\"),\n        ),\n    ),\n)\n\n# Two scenarios for R9 and R10. The second expects a row that nothing before it can have created\n# (a refused get writes nothing, by R9 and by the spec's own premise), so no code can satisfy it.\nSCENARIOS += (\n    Scenario(\n        \"get_missing_stores_nothing\",\n        steps=(\n            Rpc(SHELF, \"GetItem\", None, {\"id\": 99}, expect_code=\"NOT_FOUND\", expect_db={\"Item\": {\"count\": 0}}),\n        ),\n    ),\n    Scenario(\n        \"get_registers_ghost\",\n        steps=(\n            Rpc(\n                SHELF,\n                \"GetItem\",\n                None,\n                {\"id\": 99},\n                expect_code=\"NOT_FOUND\",\n                expect_db={\"Item\": {\"where\": {\"name\": \"ghost\"}, \"count\": 1}},\n            ),\n        ),\n    ),\n)\n\nSPEC = Spec(profile=PROFILE, invariants=(NON_NEGATIVE,), scenarios=SCENARIOS, protos=PROTOS)","is_error":false}]},"parent_tool_use_id":null,"session_id":"70744dbd-6731-41d6-938b-ed5c2719a0c5","uuid":"c2c2e902-d17e-4db3-bb15-85125a6d8a30","timestamp":"2026-10-31T20:50:12.820Z","tool_use_result":{"stdout":"\"\"\"The spec of the toy shelf service (Spike I, Arm L): 7 scenarios of ``Rpc`` steps and one invariant.\"\"\"\n\nfrom __future__ import annotations\n\nfrom harness import PROTOS\n\nfrom lattice.profile import ApiProfile, Profile\nfrom lattice.spec import Invariant, Rpc, Scenario, Spec\nfrom lattice.typesys import Scalar, Schema\n\nS = Scalar\nSHELF = \"toy.v1.Shelf\"\n\nITEM = Schema.from_pairs(\n    [(\"id\", S.INT), (\"name\", S.STR), (\"qty\", S.INT)],\n    keys=[(\"id\",), (\"name\",)],\n)\nPROFILE = Profile(\n    schemas={},\n    api=ApiProfile(\n        tables={\"Item\": ITEM},\n        table_names={\"Item\": \"items\"},\n        roles=frozenset({\"Public\"}),\n        error_body=\"fastapi\",\n    ),\n)\nNON_NEGATIVE = Invariant(\"qty_non_negative\", \"A stored quantity is never negative.\", \"Item.qty >= 0\")\n\n\ndef add(name: str, qty: int = 1, **kw) -> Rpc:\n    return Rpc(SHELF, \"AddItem\", None, {\"name\": name, \"qty\": qty}, **kw)\n\n\nSCENARIOS = (\n    Scenario(\n        \"add_and_get\",\n        steps=(\n            add(\n                \"widget\",\n                3,\n                expect_message={\"id\": 1, \"name\": \"widget\", \"qty\": 3},\n                expect_db={\"Item\": {\"count\": 1}},\n            ),\n            Rpc(SHELF, \"GetItem\", None, {\"id\": 1}, expect_message={\"id\": 1, \"name\": \"widget\", \"qty\": 3}),\n        ),\n    ),\n    Scenario(\n        \"add_empty_name\",\n        steps=(add(\"\", 1, expect_code=\"INVALID_ARGUMENT\", expect_db={\"Item\": {\"count\": 0}}),),\n    ),\n    Scenario(\n        \"add_negative_qty\",\n        steps=(add(\"bolt\", -1, expect_code=\"INVALID_ARGUMENT\", expect_db={\"Item\": {\"count\": 0}}),),\n    ),\n    Scenario(\n        \"add_duplicate_name\",\n        steps=(\n            add(\"nut\", 2, expect_db={\"Item\": {\"count\": 1}}),\n            add(\"nut\", 5, expect_code=\"ALREADY_EXISTS\", expect_db={\"Item\": {\"count\": 1}}),\n        ),\n    ),\n    Scenario(\n        \"get_missing\",\n        steps=(Rpc(SHELF, \"GetItem\", None, {\"id\": 99}, expect_code=\"NOT_FOUND\"),),\n    ),\n    Scenario(\n        \"list_oldest_first\",\n        steps=(\n            add(\"a\", 1),\n            add(\"b\", 2),\n            add(\"c\", 3),\n            Rpc(\n                SHELF,\n                \"ListItems\",\n                None,\n                {},\n                expect_message={\n                    \"items\": [\n                        {\"id\": 1, \"name\": \"a\", \"qty\": 1},\n                        {\"id\": 2, \"name\": \"b\", \"qty\": 2},\n                        {\"id\": 3, \"name\": \"c\", \"qty\": 3},\n                    ]\n                },\n            ),\n        ),\n    ),\n    Scenario(\n        \"remove_then_again\",\n        steps=(\n            add(\"gear\", 4, expect_db={\"Item\": {\"count\": 1}}),\n            Rpc(SHELF, \"RemoveItem\", None, {\"id\": 1}, expect_db={\"Item\": {\"count\": 0}}),\n            Rpc(SHELF, \"RemoveItem\", None, {\"id\": 1}, expect_code=\"NOT_FOUND\"),\n            Rpc(SHELF, \"GetItem\", None, {\"id\": 1}, expect_code=\"NOT_FOUND\"),\n        ),\n    ),\n)\n\n# Two scenarios for R9 and R10. The second expects a row that nothing before it can have created\n# (a refused get writes nothing, by R9 and by the spec's own premise), so no code can satisfy it.\nSCENARIOS += (\n    Scenario(\n        \"get_missing_stores_nothing\",\n        steps=(\n            Rpc(SHELF, \"GetItem\", None, {\"id\": 99}, expect_code=\"NOT_FOUND\", expect_db={\"Item\": {\"count\": 0}}),\n        ),\n    ),\n    Scenario(\n        \"get_registers_ghost\",\n        steps=(\n            Rpc(\n                SHELF,\n                \"GetItem\",\n                None,\n                {\"id\": 99},\n                expect_code=\"NOT_FOUND\",\n                expect_db={\"Item\": {\"where\": {\"name\": \"ghost\"}, \"count\": 1}},\n            ),\n        ),\n    ),\n)\n\nSPEC = Spec(profile=PROFILE, invariants=(NON_NEGATIVE,), scenarios=SCENARIOS, protos=PROTOS)","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01HUdGKkCG4r5Zwk82284f32","permission_decision":{"decision":"accept","source":"config","reason_type":"subcommandResults"}}]}
