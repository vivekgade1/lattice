defer rows.Close()\n\tout := &toyv1.ListItemsResponse{}\n\tfor rows.Next() {\n\t\tit := &toyv1.Item{}\n\t\tif err := rows.Scan(&it.Id, &it.Name, &it.Qty); err != nil {\n\t\t\treturn nil, status.Error(codes.Internal, err.Error())\n\t\t}\n\t\tout.Items = append(out.Items, it)\n\t}\n\tif err := rows.Err(); err != nil {\n\t\treturn nil, status.Error(codes.Internal, err.Error())\n\t}\n\treturn out, nil\n}\n\nfunc (s *shelf) RemoveItem(ctx context.Context, req *toyv1.RemoveItemRequest) (*toyv1.RemoveItemResponse, error) {\n\tres, err := s.db.ExecContext(ctx, \"delete from items where id = ?\", req.GetId())\n\tif err != nil {\n\t\treturn nil, status.Error(codes.Internal, err.Error())\n\t}\n\tn, err := res.RowsAffected()\n\tif err != nil {\n\t\treturn nil, status.Error(codes.Internal, err.Error())\n\t}\n\tif n == 0 {\n\t\treturn nil, status.Error(codes.NotFound, \"item not found\")\n\t}\n\treturn &toyv1.RemoveItemResponse{}, nil\n}\n"}}}
