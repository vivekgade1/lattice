{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01E9meTdhp7w63TCYJ3bbBGd","type":"tool_result","content":"1\t\"\"\"Lattice spec of cyclops.ui.\n2\t\n3\tGenerated by lattice.importer.emit_spec (python -m lattice.importer review DIR emit):\n4\tthe profile is PROFILE_FILE beside this module; every contract is commented with\n5\tthe status of its rule items (verified / inferred / proposed-accepted), as STATUS\n6\tholds them.\"\"\"\n7\t\n8\tfrom __future__ import annotations\n9\t\n10\timport importlib.util\n11\tfrom pathlib import Path\n12\t\n13\tfrom lattice.spec import (\n14\t    Contract,\n15\t    ContractError,\n16\t    ContractParam,\n17\t    Invariant,\n18\t    Machine,\n19\t    Spec,\n20\t    Unchecked,\n21\t)\n22\tfrom lattice.typesys import Scalar\n23\t\n24\tPACKAGE = 'cyclops.ui'\n25\tPROFILE_FILE = 'profile.py'\n26\t\n27\t\n28\tdef _profile_module():\n29\t    path = Path(__file__).resolve().parent / PROFILE_FILE\n30\t    name = \"_lattice_spec_profile_\" + str(abs(hash(str(path))))\n31\t    found = importlib.util.spec_from_file_location(name, path)\n32\t    module = importlib.util.module_from_spec(found)\n33\t    found.loader.exec_module(module)\n34\t    return module\n35\t\n36\t\n37\t_PROFILE = _profile_module()\n38\tPROFILE = _PROFILE.profile()\n39\tNATIVES = _PROFILE.NATIVES\n40\t\n41\tPROGRAMS: dict[str, str] = {\n42\t}\n43\t\n44\tUSERS: dict[str, tuple[str, str]] = {\n45\t}\n46\t\n47\tCONTRACTS: tuple[Contract, ...] = (\n48\t    # R1 GET /api/roots: inferred\n49\t    # R3 GET /api/roots 5xx: verified\n50\t    Contract(\n51\t        'GET',\n52\t        '/api/roots',\n53\t        auth='Public',\n54\t        kind='list',\n55\t    ),\n56\t    # R1 GET /api/quotes: inferred\n57\t    # R3 GET /api/quotes 5xx: verified\n58\t    Contract(\n59\t        'GET',\n60\t        '/api/quotes',\n61\t        auth='Public',\n62\t        kind='list',\n63\t    ),\n64\t    # R1 GET /api/meta: inferred\n65\t    # R3 GET /api/meta 5xx: verified\n66\t    Contract(\n67\t        'GET',\n68\t        '/api/meta',\n69\t        auth='Public',\n70\t        kind='list',\n71\t    ),\n72\t    # R1 GET /api/bars/{rung}: inferred\n73\t    # R3 GET /api/bars/{rung} 422: verified\n74\t    # R3 GET /api/bars/{rung} 5xx: verified\n75\t    Contract(\n76\t        'GET',\n77\t        '/api/bars/{rung}',\n78\t        auth='Public',\n79\t        kind='read',\n80\t        params=(\n81\t            ContractParam('rung', 'path', Scalar.STR),\n82\t            ContractParam('start', 'query', Scalar.STR, required=False),\n83\t            ContractParam('end', 'query', Scalar.STR, required=False),\n84\t            ContractParam('max_points', 'query', Scalar.INT, required=False, ge=1, le=20000),\n85\t            ContractParam('root', 'query', Scalar.STR, required=False),\n86\t        ),\n87\t        errors=(\n88\t            ContractError(422, when='invalid'),\n89\t        ),\n90\t    ),\n91\t    # R1 GET /api/bars/{rung}/windows: inferred\n92\t    # R3 GET /api/bars/{rung}/windows 422: verified\n93\t    # R3 GET /api/bars/{rung}/windows 5xx: verified\n94\t    Contract(\n95\t        'GET',\n96\t        '/api/bars/{rung}/windows',\n97\t        auth='Public',\n98\t        kind='read',\n99\t        params=(\n100\t            ContractParam('rung', 'path', Scalar.STR),\n101\t            ContractParam('stamps', 'query', Scalar.STR, required=False),\n102\t            ContractParam('before', 'query', Scalar.INT, required=False, ge=0),\n103\t            ContractParam('after', 'query', Scalar.INT, required=False, ge=0),\n104\t        ),\n105\t        errors=(\n106\t            ContractError(422, when='invalid'),\n107\t        ),\n108\t    ),\n109\t    # R1 GET /api/features/{rung}: inferred\n110\t    # R3 GET /api/features/{rung} 422: verified\n111\t    # R3 GET /api/features/{rung} 5xx: verified\n112\t    Contract(\n113\t        'GET',\n114\t        '/api/features/{rung}',\n115\t        auth='Public',\n116\t        kind='read',\n117\t        params=(\n11