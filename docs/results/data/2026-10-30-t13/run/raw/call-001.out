{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011CgaHREzsqqZgkuBkJNwR2","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_013C9zJzhS93AFgpwLFdYpHQ","name":"Write","input":{"file_path":"/private/var/folders/fj/tl69n2xd067clrqbx31xtrtr0000gn/T/t13-6o4o32at/build-repo/.lattice/rebuilds/t13-cyclops-b1-19c0ae/cyclops/ui/server.py","content":"\"\"\"FastAPI binding over `Store` and `UserStore`: the viewer's HTTP surface.\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import Any, Callable\n\nfrom fastapi import Body, FastAPI, Query\nfrom fastapi.responses import JSONResponse\n\nfrom cyclops import config\nfrom cyclops.ui.store import DEFAULT_MAX_POINTS, Store\nfrom cyclops.ui.user_store import UserStore, UserStoreError\n\n\ndef _json(payload: Any, status: int = 200) -> JSONResponse:\n    return JSONResponse(content=payload, status_code=status)\n\n\ndef _answer(call: Callable[[], Any]) -> JSONResponse:\n    \"\"\"Run one store read: a refusal ({exists: false, error}) is a 422, a bad value too.\"\"\"\n    try:\n        payload = call()\n    except (ValueError, TypeError, OverflowError) as exc:\n        return _json({\"exists\": False, \"error\": str(exc), \"hint\": \"check the query parameters\"}, 422)\n    if isinstance(payload, dict) and payload.get(\"exists\") is False and \"error\" in payload:\n        return _json(payload, 422)\n    return _json(payload)\n\n\ndef create_app(store: Store | None = None, users: UserStore | None = None) -> FastAPI:\n    \"\"\"Build the FastAPI app bound to one `Store` (one artifact root) and its `UserStore`.\"\"\"\n    if store is None:\n        store = Store()\n    if users is None:\n        users = UserStore(store.root)\n    app = FastAPI(title=\"cyclops\")\n\n    @app.exception_handler(UserStoreError)\n    async def _user_error(_request, exc: UserStoreError) -> JSONResponse:\n        return _json({\"exists\": False, \"error\": exc.error, \"hint\": exc.hint}, exc.status)\n\n    @app.get(\"/api/roots\")\n    def roots():\n        return _answer(store.roots)\n\n    @app.get(\"/api/quotes\")\n    def quotes():\n        return _answer(store.quotes)\n\n    @app.get(\"/api/meta\")\n    def meta():\n        return _answer(store.meta)\n\n    @app.get(\"/api/bars/{rung}\")\n    def bars(rung: str, start: str | None = None, end: str | None = None,\n             max_points: int = Query(DEFAULT_MAX_POINTS, ge=1, le=20000),\n             root: str = config.ASSET):\n        return _answer(lambda: store.bars(rung, start, end, max_points, root))\n\n    @app.get(\"/api/bars/{rung}/windows\")\n    def windows(rung: str, stamps: str | None = None,\n                before: int = Query(40, ge=0), after: int = Query(20, ge=0)):\n        parts = [s.strip() for s in (stamps or \"\").split(\",\") if s.strip()]\n        return _answer(lambda: store.bar_windows(rung, parts, before, after))\n\n    @app.get(\"/api/features/{rung}\")\n    def features(rung: str, cols: str | None = None, start: str | None = None,\n                 end: str | None = None,\n                 max_points: int = Query(DEFAULT_MAX_POINTS, ge=1, le=20000),\n                 root: str = config.ASSET):\n        names = [c.strip() for c in cols.split(\",\") if c.strip()] if cols else None\n        return _answer(lambda: store.features(rung, names, start, end, max_points, root))\n\n    @app.get(\"/api/regimes\")\n    def regimes(start: str | None = None, end: str | None = None, rung: str = \"1h\",\n                root: str = config.ASSET):\n        return _answer(lambda: store.regimes(start, end, rung, root))\n\n    @app.get(\"/api/bar/{ts}\")\n    def bar(ts: str, rung: str = \"1h\"):\n        return _answer(lambda: store.bar_detail(ts, rung))\n\n    @app.get(\"/api/patterns/{rung}/similar\")\n    def similar(rung: str, ts: str | None = None, pattern: str | None = None,\n                k: int = Query(config.PATTERN_SIM_K, ge=1), layer: str = \"cell\",\n                metric: str = \"euclid\"):\n        return _answer(lambda: store.patterns_similar(rung, ts, k, layer, metric, pattern))\n\n    @app.get(\"/api/patterns/{rung}\")\n    def patterns(rung: str, start: str | None = None, end: str | None = None,\n                 root: str = config.ASSET):\n        return _answer(lambda: store.patterns(rung, start, end, root))\n\n    @app.get(\"/api/structure/{rung}\")\n    def structure(rung: str, start: str | None = None, end: str | None = None,\n                  root: str = config.ASSET):\n        return _answer(lambda: store.structure(rung, start, end, root))\n\n    @app.get(\"/api/formations/{rung}\")\n    def formations(rung: str, start: str | None = None, end: str | None = None,\n                   root: str = config.ASSET):\n        return _answer(lambda: store.formations(rung, start, end, root))\n\n    @app.get(\"/api/bands/{rung}\")\n    def bands(rung: str, root: str = \"NQ\", start: str | None = None, end: str | None = None):\n        return _answer(lambda: store.bands(rung, root, start, end))\n\n    @app.get(\"/api/memory/{ts}\")\n    def memory(ts: str, k: int = Query(config.MEMORY_K, ge=1, le=500)):\n        return _answer(lambda: store.memory(ts, k))\n\n    @app.get(\"/api/profiles\")\n    def profiles():\n        return _answer(store.profiles)\n\n    @app.get(\"/api/validation/{split}\")\n    def validation(split: str):\n        return _answer(lambda: store.validation(split))\n\n    @app.get(\"/api/dq\")\n    def dq():\n        return _answer(store.dq)\n\n    @app.get(\"/api/eod\")\n    def eod_index():\n        return _answer(store.eod_index)\n\n    @app.get(\"/api/eod/{d}\")\n    def eod(d: str):\n        return _answer(lambda: store.eod(d))\n\n    @app.get(\"/api/journal/{d}\")\n    def journal(d: str):\n        return _answer(lambda: store.journal(d))\n\n    @app.get(\"/api/rolling\")\n    def rolling():\n        return _answer(store.rolling)\n\n    @app.get(\"/api/registry\")\n    def registry():\n        return _answer(store.registry)\n\n    @app.get(\"/api/parity\")\n    def parity():\n        return _answer(store.parity)\n\n    @app.get(\"/api/live\")\n    def live():\n        return _answer(store.live)\n\n    @app.get(\"/api/user/drawings/{rung}\")\n    def get_drawings(rung: str):\n        return _json(users.get_drawings(rung))\n\n    @app.put(\"/api/user/drawings/{rung}\")\n    def put_drawings(rung: str, doc: Any = Body(None)):\n        return _json(users.put_drawings(rung, doc))\n\n    @app.get(\"/api/user/setups\")\n    def list_setups():\n        return _json(users.list_setups())\n\n    @app.get(\"/api/user/setups/{slug}\")\n    def get_setup(slug: str):\n        out = users.get_setup(slug)\n        return _json(out, 404 if out.get(\"exists\") is False else 200)\n\n    @app.put(\"/api/user/setups/{slug}\")\n    def put_setup(slug: str, doc: Any = Body(None)):\n        return _json(users.put_setup(slug, doc))\n\n    @app.delete(\"/api/user/setups/{slug}\")\n    def delete_setup(slug: str):\n        out = users.delete_setup(slug)\n        return _json(out, 404 if out.get(\"exists\") is False else 200)\n\n    return app\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2945,"cache_read_input_tokens":34940,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2945},"output_tokens":4,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"25e55146-d7ad-4b00-9b04-b33f1b7f87c0","uuid":"3ecd1bf5-915e-422e-a507-1cabe14cd06b","timestamp":"2026-10-31T12:05:00.308Z","request_id":"req_011CgaHREkVGxf5yKkvxUgPA","wire_tool_inputs":{"toolu_013C9zJzhS93AFgpwLFdYpHQ":{"file_path":"/private/var/folders/fj/tl69n2xd067clrqbx31xtrtr0000gn/T/t13-6o4o32at/build-repo/.lattice/rebuilds/t13-cyclops-b1-19c0ae/cyclops/ui/server.py","content":"\"\"\"FastAPI binding over `Store` and `UserStore`: the viewer's HTTP surface.\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import Any, Callable\n\nfrom fastapi import Body, FastAPI, Query\nfrom fastapi.responses import JSONResponse\n\nfrom cyclops import config\nfrom cyclops.ui.store import DEFAULT_MAX_POINTS, Store\nfrom cyclops.ui.user_store import UserStore, UserStoreError\n\n\ndef _json(payload: Any, status: int = 200) -> JSONResponse:\n    return JSONResponse(content=payload, status_code=status)\n\n\ndef _answer(call: Callable[[], Any]) -> JSONResponse:\n    \"\"\"Run one store read: a refusal ({exists: false, error}) is a 422, a bad value too.\"\"\"\n    try:\n        payload = call()\n    except (ValueError, TypeError, OverflowError) as exc:\n        return _json({\"exists\": False, \"error\": str(exc), \"hint\": \"check the query parameters\"}, 422)\n    if isinstance(payload, dict) and payload.get(\"exists\") is False and \"error\" in payload:\n        return _json(payload, 422)\n    return _json(payload)\n\n\ndef create_app(store: Store | None = None, users: UserStore | None = None) -> FastAPI:\n    \"\"\"Build the FastAPI app bound to one `Store` (one artifact root) and its `UserStore`.\"\"\"\n    if store is None:\n        store = Store()\n    if users is None:\n        users = UserStore(store.root)\n    app = FastAPI(title=\"cyclops\")\n\n    @app.exception_handler(UserStoreError)\n    async def _user_error(_request, exc: UserStoreError) -> JSONResponse:\n        return _json({\"exists\": False, \"error\": exc.error, \"hint\": exc.hint}, exc.status)\n\n    @app.get(\"/api/roots\")\n    def roots():\n        return _answer(store.roots)\n\n    @app.get(\"/api/quotes\")\n    def quotes():\n        return _answer(store.quotes)\n\n    @app.get(\"/api/meta\")\n    def meta():\n        return _answer(store.meta)\n\n    @app.get(\"/api/bars/{rung}\")\n    def bars(rung: str, start: str | None = None, end: str | None = None,\n             max_points: int = Query(DEFAULT_MAX_POINTS, ge=1, le=20000),\n             root: str = config.ASSET):\n        return _answer(lambda: store.bars(rung, start, end, max_points, root))\n\n    @app.get(\"/api/bars/{rung}/windows\")\n    def windows(rung: str, stamps: str | None = None,\n                before: int = Query(40, ge=0), after: int = Query(20, ge=0)):\n        parts = [s.strip() for s in (stamps or \"\").split(\",\") if s.strip()]\n        return _answer(lambda: store.bar_windows(rung, parts, before, after))\n\n    @app.get(\"/api/features/{rung}\")\n    def features(rung: str, cols: str | None = None, start: str | None = None,\n                 end: str | None = None,\n                 max_points: int = Query(DEFAULT_MAX_POINTS, ge=1, le=20000),\n                 root: str = config.ASSET):\n        names = [c.strip() for c in cols.split(\",\") if c.strip()] if cols else None\n        return _answer(lambda: store.features(rung, names, start, end, max_points, root))\n\n    @app.get(\"/api/regimes\")\n    def regimes(start: str | None = None, end: str | None = None, rung: str = \"1h\",\n                root: str = config.ASSET):\n        return _answer(lambda: store.regimes(start, end, rung, root))\n\n    @app.get(\"/api/bar/{ts}\")\n    def bar(ts: str, rung: str = \"1h\"):\n        return _answer(lambda: store.bar_detail(ts, rung))\n\n    @app.get(\"/api/patterns/{rung}/similar\")\n    def similar(rung: str, ts: str | None = None, pattern: str | None = None,\n                k: int = Query(config.PATTERN_SIM_K, ge=1), layer: str = \"cell\",\n                metric: str = \"euclid\"):\n        return _answer(lambda: store.patterns_similar(rung, ts, k, layer, metric, pattern))\n\n    @app.get(\"/api/patterns/{rung}\")\n    def patterns(rung: str, start: str | None = None, end: str | None = None,\n                 root: str = config.ASSET):\n        return _answer(lambda: store.patterns(rung, start, end, root))\n\n    @app.get(\"/api/structure/{rung}\")\n    def structure(rung: str, start: str | None = None, end: str | None = None,\n                  root: str = config.ASSET):\n        return _answer(lambda: store.structure(rung, start, end, root))\n\n    @app.get(\"/api/formations/{rung}\")\n    def formations(rung: str, start: str | None = None, end: str | None = None,\n                   root: str = config.ASSET):\n        return _answer(lambda: store.formations(rung, start, end, root))\n\n    @app.get(\"/api/bands/{rung}\")\n    def bands(rung: str, root: str = \"NQ\", start: str | None = None, end: str | None = None):\n        return _answer(lambda: store.bands(rung, root, start, end))\n\n    @app.get(\"/api/memory/{ts}\")\n    def memory(ts: str, k: int = Query(config.MEMORY_K, ge=1, le=500)):\n        return _answer(lambda: store.memory(ts, k))\n\n    @app.get(\"/api/profiles\")\n    def profiles():\n        return _answer(store.profiles)\n\n    @app.get(\"/api/validation/{split}\")\n    def validation(split: str):\n        return _answer(lambda: store.validation(split))\n\n    @app.get(\"/api/dq\")\n    def dq():\n        return _answer(store.dq)\n\n    @app.get(\"/api/eod\")\n    def eod_index():\n        return _answer(store.eod_index)\n\n    @app.get(\"/api/eod/{d}\")\n    def eod(d: str):\n        return _answer(lambda: store.eod(d))\n\n    @app.get(\"/api/journal/{d}\")\n    def journal(d: str):\n        return _answer(lambda: store.journal(d))\n\n    @app.get(\"/api/rolling\")\n    def rolling():\n        return _answer(store.rolling)\n\n    @app.get(\"/api/registry\")\n    def registry():\n        return _answer(store.registry)\n\n    @app.get(\"/api/parity\")\n    def parity():\n        return _answer(store.parity)\n\n    @app.get(\"/api/live\")\n    def live():\n        return _answer(store.live)\n\n    @app.get(\"/api/user/drawings/{rung}\")\n    def get_drawings(rung: str):\n        return _json(users.get_drawings(rung))\n\n    @app.put(\"/api/user/drawings/{rung}\")\n    def put_drawings(rung: str, doc: Any = Body(None)):\n        return _json(users.put_drawings(rung, doc))\n\n    @app.get(\"/api/user/setups\")\n    def list_setups():\n        return _json(users.list_setups())\n\n    @app.get(\"/api/user/setups/{slug}\")\n    def get_setup(slug: str):\n        out = users.get_setup(slug)\n        return _json(out, 404 if out.get(\"exists\") is False else 200)\n\n    @app.put(\"/api/user/setups/{slug}\")\n    def put_setup(slug: str, doc: Any = Body(None)):\n        return _json(users.put_setup(slug, doc))\n\n    @app.delete(\"/api/user/setups/{slug}\")\n    def delete_setup(slug: str):\n        out = users.delete_setup(slug)\n        return _json(out, 404 if out.get(\"exists\") is False else 200)\n\n    return app\n"}}}
