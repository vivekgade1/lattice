api/bars/{rung}: inferred\n    # R3 GET /api/bars/{rung} 422: verified\n    # R3 GET /api/bars/{rung} 5xx: verified\n    Contract(\n        'GET',\n        '/api/bars/{rung}',\n        auth='Public',\n        kind='read',\n        params=(\n            ContractParam('rung', 'path', Scalar.STR),\n            ContractParam('start', 'query', Scalar.STR, required=False),\n            ContractParam('end', 'query', Scalar.STR, required=False),\n            ContractParam('max_points', 'query', Scalar.INT, required=False, ge=1, le=20000),\n            ContractParam('root', 'query', Scalar.STR, required=False),\n        ),\n        errors=(\n            ContractError(422, when='invalid'),\n        ),\n    ),\n    # R1 GET /api/bars/{rung}/windows: inferred\n    # R3 GET /api/bars/{rung}/windows 422: verified\n    # R3 GET /api/bars/{rung}/windows 5xx: verified\n    Contract(\n        'GET',\n        '/api/bars/{rung}/windows',\n        auth='Public',\n        kind='read',\n        params=(\n            ContractParam('rung', 'path', Scalar.STR),\n            ContractParam('stamps', 'query', Scalar.STR, required=False),\n            ContractParam('before', 'query', Scalar.INT, required=False, ge=0),\n            ContractParam('after', 'query', Scalar.INT, required=False, ge=0),\n        ),\n        errors=(\n            ContractError(422, when='invalid'),\n        ),\n    ),\n    # R1 GET /api/features/{rung}: inferred\n    # R3 GET /api/features/{rung} 422: verified\n    # R3 GET /api/features/{rung} 5xx: verified\n    Contract(\n        'GET',\n        '/api/features/{rung}',\n        auth='Public',\n        kind='read',\n        params=(\n            ContractParam('rung', 'path', Scalar.STR),\n            ContractParam('cols', 'query', Scalar.STR, required=False),\n            ContractParam('start', 'query', Scalar.STR, required=False),\n            ContractParam('end', 'query', Scalar.STR, required=False),\n            ContractParam('max_points', 'query', Scalar.INT, required=False, ge=1, le=20000),\n            ContractParam('root', 'query', Scalar.STR, required=False),\n        ),\n        errors=(\n            ContractError(422, when='invalid'),\n        ),\n    ),\n    # R1 GET /api/regimes: inferred\n    # R3 GET /api/regimes 5xx: verified\n    Contract(\n        'GET',\n        '/api/regimes',\n        auth='Public',\n        kind='list',\n        params=(\n            ContractParam('start', 'query', Scalar.STR, required=False),\n            ContractParam('end', 'query', Scalar.STR, required=False),\n            ContractParam('rung', 'query', Scalar.STR, required=False),\n            ContractParam('root', 'query', Scalar.STR, required=False),\n        ),\n    ),\n    # R1 GET /api/bar/{ts}: inferred\n    # R3 GET /api/bar/{ts} 5xx: verified\n    Contract(\n        'GET',\n        '/api/bar/{ts}',\n        auth='Public',\n        kind='read',\n        params=(\n            ContractParam('ts', 'path', Scalar.STR),\n            ContractParam('rung', 'query', Scalar.STR, required=False),\n        ),\n    ),\n    # R1 GET /api/patterns/{rung}: inferred\n    # R3 GET /api/patterns/{rung} 5xx: verified\n    Contract(\n        'GET',\n        '/api/patterns/{rung}',\n        auth='Public',\n        kind='read',\n        params=(\n            ContractParam('rung', 'path', Scalar.STR),\n            ContractParam('start', 'query', Scalar.STR, required=False),\n            ContractParam('end', 'query', Scalar.STR, required=False),\n            ContractParam('root', 'query', Scalar.STR, required=False),\n        ),\n    ),\n    # R1 GET /api/patterns/{rung}/similar: inferred\n    # R3 GET /api/patterns/{rung}/similar 422: verified\n    # R3 GET /api/patterns/{rung}/similar 5xx: verified\n    Contract(\n        'GET',\n        '/api/patterns/{rung}/similar',\n        auth='Public',\n        kind='read',\n        params=(\n            ContractParam('rung', 'path', Scalar.STR),\n            ContractParam('ts', 'query', Scalar.STR, required=Fal